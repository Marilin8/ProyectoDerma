<Window x:Class="Derma.UI.Views.DashboardWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Derma.UI.ViewModels"
        xmlns:views="clr-namespace:Derma.UI.Views"
        xmlns:conv="clr-namespace:Derma.UI.Converters"
        Title="DERMA — Panel"
        Height="820" Width="1360"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        MinHeight="600" MinWidth="1000">

    <Window.Resources>
        <conv:StringEqualsConverter x:Key="StringEqualsConverter" />
        <conv:GreaterThanZeroToVisibilityConverter x:Key="GreaterThanZeroToVisibilityConverter" />

        <DataTemplate DataType="{x:Type vm:InicioViewModel}">
            <views:InicioView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PlaceholderViewModel}">
            <views:PlaceholderView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ConsultasViewModel}">
            <views:ConsultasView />
        </DataTemplate>

        <Style x:Key="ItemNav" TargetType="RadioButton">
            <Setter Property="Height" Value="42" />
            <Setter Property="Margin" Value="16,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#445655" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Fondo" CornerRadius="8" Background="Transparent">
                            <ContentPresenter Margin="12,0" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#E6F3F0" />
                                <Setter Property="Foreground" Value="#2F8F7C" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Fondo" Property="Background" Value="#EEF2F1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="260" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sidebar -->
        <Border Grid.Column="0" Background="White" BorderBrush="#E6E9E8" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="24,28,24,20">
                    <TextBlock Text="PERFIL" FontSize="20" FontWeight="Bold" Foreground="#1C2B2D" />
                    <TextBlock Text="Dermatología Clínica" FontSize="12" Foreground="#7A8988" Margin="0,2,0,20" />

                    <Border Width="84" Height="84" CornerRadius="42" Background="#E6F3F0" HorizontalAlignment="Center">
                        <TextBlock Text="🙂" FontSize="36" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock HorizontalAlignment="Center" Margin="0,10,0,0" FontSize="14" FontWeight="SemiBold" Foreground="#1C2B2D">
                        <Run Text="{Binding NombreCompleto}" />
                        <Run Text=" - " />
                        <Run Text="{Binding RolTexto}" />
                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Row="1">
                    <RadioButton Style="{StaticResource ItemNav}" GroupName="Nav"
                                 IsChecked="{Binding SeccionActiva, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Inicio, Mode=OneWay}"
                                 Command="{Binding IrAInicioCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⊞" FontSize="16" Width="24" />
                            <TextBlock Text="Inicio" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ItemNav}" GroupName="Nav"
                                 IsChecked="{Binding SeccionActiva, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Mi Cuenta, Mode=OneWay}"
                                 Command="{Binding IrAMiCuentaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#128100;" FontSize="16" Width="24" />
                            <TextBlock Text="Mi Cuenta" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ItemNav}" GroupName="Nav"
                                 IsChecked="{Binding SeccionActiva, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Configuración, Mode=OneWay}"
                                 Command="{Binding IrAConfiguracionCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="⚙" FontSize="16" Width="24" />
                            <TextBlock Text="Configuración" />
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ItemNav}" GroupName="Nav"
                                 IsChecked="{Binding SeccionActiva, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Notificaciones, Mode=OneWay}"
                                 Command="{Binding IrANotificacionesCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔔" FontSize="16" Width="24" />
                            <TextBlock Text="Notificaciones" />
                            <Border Background="#2F8F7C" CornerRadius="9" Padding="6,1" Margin="8,0,0,0"
                                    Visibility="{Binding NotificacionesCount, Converter={StaticResource GreaterThanZeroToVisibilityConverter}}">
                                <TextBlock Text="{Binding NotificacionesCount}" Foreground="White" FontSize="10" FontWeight="Bold" />
                            </Border>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton Style="{StaticResource ItemNav}" GroupName="Nav"
                                 IsChecked="{Binding SeccionActiva, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Ayuda, Mode=OneWay}"
                                 Command="{Binding IrAAyudaCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="?" FontSize="16" Width="24" FontWeight="Bold" />
                            <TextBlock Text="Ayuda" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <Button Grid.Row="2" Margin="16,10,16,20" Padding="12" HorizontalContentAlignment="Left"
                        Background="Transparent" BorderThickness="0" Cursor="Hand" Foreground="#B3261E"
                        Command="{Binding CerrarSesionCommand}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="⏻" FontSize="16" Width="24" />
                        <TextBlock Text="Cerrar Sesión" FontSize="14" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Contenido principal -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="White" BorderBrush="#E6E9E8" BorderThickness="0,0,0,1" Padding="24,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F4F6F8" CornerRadius="8" Padding="12,8" MaxWidth="360" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔍" FontSize="14" Margin="0,0,8,0" />
                            <TextBlock Text="Buscar" Foreground="#9AA6A5" FontSize="14" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Border Width="38" Height="38" CornerRadius="19" Background="#F4F6F8" Margin="0,0,12,0">
                            <Grid>
                                <TextBlock Text="🔔" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Ellipse Width="8" Height="8" Fill="#E53935" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" />
                            </Grid>
                        </Border>
                        <Border Width="38" Height="38" CornerRadius="19" Background="#F4F6F8">
                            <TextBlock Text="🙂" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <ContentControl Grid.Row="1" Content="{Binding PaginaActual}" />
        </Grid>
    </Grid>
</Window>
