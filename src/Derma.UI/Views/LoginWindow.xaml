<Window x:Class="Derma.UI.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DERMA — Acceso"
        Height="620" Width="460"
        WindowStartupLocation="CenterScreen"
        Background="#F4F6F8"
        ResizeMode="CanMinimize">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <Style x:Key="CampoLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#445655" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="CampoInput" TargetType="Control">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,0,16" />
            <Setter Property="BorderBrush" Value="#D3DBDA" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style TargetType="TextBox" BasedOn="{StaticResource CampoInput}" />
        <Style TargetType="PasswordBox" BasedOn="{StaticResource CampoInput}" />

        <Style x:Key="BotonPrimario" TargetType="Button">
            <Setter Property="Background" Value="#2F8F7C" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="12" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#267566" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="BotonEnlace" TargetType="Button">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#2F8F7C" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid>
        <Border Background="White"
                CornerRadius="14"
                Padding="36,40"
                Width="380"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.12" Color="#000000" />
            </Border.Effect>

            <StackPanel>
                <Border Width="56" Height="56" CornerRadius="28" Background="#E6F3F0"
                        HorizontalAlignment="Center" Margin="0,0,0,16">
                    <TextBlock Text="✚" FontSize="24" Foreground="#2F8F7C"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <TextBlock Text="DERMA" FontSize="24" FontWeight="Bold" Foreground="#1C2B2D"
                           HorizontalAlignment="Center" Margin="0,0,0,4" />
                <TextBlock Text="Sistema de Gestión Dermatológica" FontSize="13" Foreground="#7A8988"
                           HorizontalAlignment="Center" Margin="0,0,0,24" />

                <Border Background="#FDECEA" CornerRadius="8" Padding="10,8" Margin="0,0,0,16"
                        Visibility="{Binding TieneError, Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding MensajeError}" Foreground="#B3261E" FontSize="13" TextWrapping="Wrap" />
                </Border>

                <TextBlock Text="Usuario" Style="{StaticResource CampoLabel}" />
                <TextBox x:Name="TxtUsuario" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="Contraseña" Style="{StaticResource CampoLabel}" />
                <PasswordBox x:Name="TxtPassword" />

                <Button Content="Ingresar" Style="{StaticResource BotonPrimario}"
                        Margin="0,8,0,16" Click="BtnIngresar_Click" />

                <Button Content="¿No tienes cuenta? Regístrate aquí" Style="{StaticResource BotonEnlace}"
                        Click="BtnIrARegistro_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
