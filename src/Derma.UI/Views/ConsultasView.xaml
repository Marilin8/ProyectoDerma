<UserControl x:Class="Derma.UI.Views.ConsultasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <Style x:Key="BotonAccionAzul" TargetType="Button">
            <Setter Property="Background" Value="#3E7FD9" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="BotonAccionVerde" TargetType="Button" BasedOn="{StaticResource BotonAccionAzul}">
            <Setter Property="Background" Value="#3FA085" />
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="32,24">
        <TextBlock Text="GESTIÓN DE CONSULTAS" FontSize="12" FontWeight="Bold" Foreground="#7A8988" Margin="0,0,0,4" />
        <TextBlock Text="Módulo de Consultas" FontSize="28" FontWeight="Bold" Foreground="#1C2B2D" />
        <TextBlock Text="Listado y Gestión de Pacientes" FontSize="14" Foreground="#7A8988" Margin="0,2,0,24" />

        <Border Background="White" CornerRadius="12" Padding="24">
            <StackPanel>
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#F4F6F8" CornerRadius="8" Padding="14,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="🔍" FontSize="14" Margin="0,0,10,0" VerticalAlignment="Center" />
                            <Grid Grid.Column="1">
                                <TextBlock Text="Buscar paciente por nombre o DPI..." Foreground="#9AA6A5" FontSize="14"
                                           VerticalAlignment="Center" IsHitTestVisible="False">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TextoBusqueda}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBox Text="{Binding TextoBusqueda, UpdateSourceTrigger=PropertyChanged}"
                                         Background="Transparent" BorderThickness="0" FontSize="14" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>
                    </Border>

                    <Button Grid.Column="2" Content="Nuevo paciente  +" Style="{StaticResource BotonAccionAzul}"
                            Padding="18,12" FontSize="14" FontWeight="SemiBold"
                            Command="{Binding NuevoPacienteCommand}" />
                </Grid>

                <DataGrid ItemsSource="{Binding VistaPacientes}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EEF1F0" Background="Transparent" BorderThickness="0"
                          RowBackground="Transparent" CanUserAddRows="False" CanUserResizeRows="False"
                          RowHeight="52">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="Foreground" Value="#1C2B2D" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="FontSize" Value="13" />
                            <Setter Property="Padding" Value="4,10" />
                            <Setter Property="HorizontalContentAlignment" Value="Left" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#EEF1F0" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.CellStyle>
                        <Style TargetType="DataGridCell">
                            <Setter Property="BorderThickness" Value="0" />
                            <Setter Property="Padding" Value="4,8" />
                            <Setter Property="FontSize" Value="14" />
                            <Setter Property="Background" Value="Transparent" />
                        </Style>
                    </DataGrid.CellStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Paciente" Binding="{Binding Nombre}" Width="1.4*" />
                        <DataGridTextColumn Header="DPI / ID" Binding="{Binding Dpi}" Width="1.2*" />
                        <DataGridTextColumn Header="Última Consulta" Binding="{Binding UltimaConsulta}" Width="1.1*" />
                        <DataGridTextColumn Header="Médico Asignado" Binding="{Binding MedicoAsignado}" Width="1.2*" />
                        <DataGridTemplateColumn Header="Acciones" Width="1.6*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Content="📄 Consultar" Style="{StaticResource BotonAccionAzul}" Margin="0,0,8,0"
                                                Command="{Binding DataContext.ConsultarCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                        <Button Content="📋 Historial" Style="{StaticResource BotonAccionVerde}"
                                                Command="{Binding DataContext.VerHistorialCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
